{% from "bd_url.j2" import bd_url %}
# Despliegue completo del sistema. Generado desde el modelo ArchiMate + spec.yaml.
#   docker compose up --build
#
#   Gateway (API única para el frontend) ... http://localhost:8080/api/<contexto>/...
{% if frontend %}
#   Aplicación web (shell + microfrontends)  http://localhost:{{ frontend.shell.puerto }}
{% endif %}
#   Cada servicio también queda expuesto en su propio puerto (ver abajo).
{% set sqls = sistema.contextos | selectattr("base_datos.tipo", "equalto", "SQL") | list %}
{% set mongos = sistema.contextos | rejectattr("base_datos.tipo", "equalto", "SQL") | list %}
services:
{% for ctx in sistema.contextos %}
  {{ ctx.carpeta }}:
    build: ./{{ ctx.carpeta }}
    ports: ["{{ ctx.puerto }}:{{ ctx.puerto }}"]
    environment:
      PUERTO: "{{ ctx.puerto }}"
      PERSISTENCIA: bd
      BD_URL: "{{ bd_url(ctx) }}"
{% if ctx.base_datos.tipo | upper == "SQL" and ctx.lenguaje == "java" %}
      BD_USUARIO: farmacia
      BD_CLAVE: farmacia
{% endif %}
      CLAVE_CIFRADO: ${CLAVE_CIFRADO:-farmacia-2026}
{% for r in ctx.proveedores %}
      {{ r.proveedor | snake | upper }}_URL: http://{{ sistema.contexto(r.proveedor).carpeta }}:{{ sistema.contexto(r.proveedor).puerto }}
{% endfor %}
{% if ctx.integraciones %}
      ACL_URL: http://{{ sistema.acl.carpeta }}:{{ sistema.acl.puerto }}
{% endif %}
    depends_on:
{% if ctx.base_datos.tipo | upper == "SQL" %}
      bd-init:
        condition: service_completed_successfully
{% else %}
      mongo:
        condition: service_healthy
{% endif %}
    restart: on-failure

{% endfor %}
{% if sistema.acl %}
  {{ sistema.acl.carpeta }}:
    build: ./{{ sistema.acl.carpeta }}
    ports: ["{{ sistema.acl.puerto }}:{{ sistema.acl.puerto }}"]
    environment:
      PUERTO: "{{ sistema.acl.puerto }}"
{% for ctx in sistema.contextos if ctx.integraciones %}
      {{ ctx.variable_url }}: http://{{ ctx.carpeta }}:{{ ctx.puerto }}
{% endfor %}
    restart: on-failure

{% endif %}
  gateway:
    image: nginx:1.27-alpine
    ports: ["8080:80"]
    volumes:
      - ./gateway/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on: [{% for ctx in sistema.contextos %}{{ ctx.carpeta }}, {% endfor %}{{ sistema.acl.carpeta if sistema.acl }}]
{% if frontend %}

  # ---------------- Frontend: un contenedor por microfrontend (despliegue independiente)
{% for mf in frontend.remotos %}
  {{ mf.carpeta }}:
    build: ./frontend/{{ mf.carpeta }}
    ports: ["{{ mf.puerto }}:80"]

{% endfor %}
  {{ frontend.shell.carpeta }}:
    build: ./frontend/{{ frontend.shell.carpeta }}
    ports: ["{{ frontend.shell.puerto }}:80"]
    depends_on: [{% for mf in frontend.remotos %}{{ mf.carpeta }}{{ ", " if not loop.last }}{% endfor %}]
{% endif %}
{% if sqls %}

  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: farmacia
      POSTGRES_PASSWORD: farmacia
    ports: ["5432:5432"]
    volumes:
      - ./bd/postgres:/docker-entrypoint-initdb.d:ro
      - datos-postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U farmacia"]
      interval: 5s
      retries: 20

  bd-init:
    image: postgres:16
    depends_on:
      postgres: { condition: service_healthy }
    environment: { PGPASSWORD: farmacia }
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        for db in {% for ctx in sqls %}{{ ctx.snake }}{{ " " if not loop.last }}{% endfor %}; do
          psql -h postgres -U farmacia -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='$$db'" | grep -q 1 \
            || psql -h postgres -U farmacia -d postgres -c "CREATE DATABASE $$db"
        done
    restart: "no"
{% endif %}
{% if mongos %}

  mongo:
    image: mongo:7
    ports: ["27017:27017"]
    volumes:
      - datos-mongo:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 5s
      retries: 20
{% endif %}

volumes:
{% if sqls %}
  datos-postgres:
{% endif %}
{% if mongos %}
  datos-mongo:
{% endif %}
