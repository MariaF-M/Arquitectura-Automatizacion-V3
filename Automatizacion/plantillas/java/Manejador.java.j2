    private {{ a.clase }} cargar(String id) {
        {{ a.clase }} a = repo.obtener(id);
        if (a == null) throw new NoEncontradoException("{{ a.clase }} " + id + " no existe");
        return a;
    }

    private Map<String, Object> confirmar({{ a.clase }} a) {
        repo.guardar(a);
        a.extraerEventos().forEach(bus::publicar);
        return a.aMapa();
    }
