from __future__ import annotations

import re
import uuid
from dataclasses import dataclass
from datetime import date

from {{ L.modelo }}.errores import ReglaNegocioError
from {{ L.eventos }}.eventos import EventoDominio{% for e in a.eventos %}, {{ e.clase }}{% endfor %}



CAMPOS = {
{% for at in a.atributos %}
    "{{ at.snake }}": {{ tipo_py(at.tipo) }},
{% endfor %}
}
VALORES_INICIALES = {{ a.valores_iniciales | tojson }}
OBLIGATORIOS = ({% for x in a.obligatorios %}"{{ x | snake }}", {% endfor %})
NO_NEGATIVOS = ({% for x in a.no_negativos %}"{{ x | snake }}", {% endfor %})
VALORES_PERMITIDOS = {
{% for campo, valores in a.valores_permitidos.items() %}
    "{{ campo | snake }}": {{ valores | tojson }},
{% endfor %}
}


# Reglas de formato por atributo (spec.yaml -> formatos): patrón, rango y largo máximo
FORMATOS = {
{% for at in a.atributos if at.patron or at.minimo is not none or at.maximo is not none or at.max_largo %}
    "{{ at.snake }}": {"patron": {{ at.patron | py }}, "mensaje": {{ at.mensaje | py }}, "minimo": {{ at.minimo | py }}, "maximo": {{ at.maximo | py }}, "max_largo": {{ at.max_largo | py }}},
{% endfor %}
}


def _convertir(tipo, valor):
    """Convierte un valor recibido al tipo del atributo. Lanza ValueError si no se puede."""
    if valor is None:
        return None
    if tipo is str:
        texto = str(valor).strip()          # se ignoran espacios al inicio y al final
        return texto or None                # "   " cuenta como vacío
    if isinstance(valor, str) and not valor.strip():
        return None
    if tipo is bool:
        if isinstance(valor, bool):
            return valor
        if str(valor).strip().lower() in ("true", "false"):
            return str(valor).strip().lower() == "true"
        raise ValueError("se esperaba true o false")
    if isinstance(valor, bool):              # True/False no son números válidos
        raise ValueError("se esperaba un número")
    if tipo is int:
        if isinstance(valor, float) and not valor.is_integer():
            raise ValueError("se esperaba un número entero")
        return int(str(valor).strip()) if isinstance(valor, str) else int(valor)
    if tipo is float:
        return float(str(valor).strip().replace(",", ".")) if isinstance(valor, str) else float(valor)
    if tipo is date:
        return valor if isinstance(valor, date) else date.fromisoformat(str(valor).strip())
    return tipo(valor)


@dataclass(frozen=True)
class {{ a.clase }}Memento:
    """Memento (GoF): foto inmutable del estado de {{ a.clase }}. Solo el agregado sabe crearla y leerla."""
    id: str
{% for at in a.atributos %}
    {{ at.snake }}: {{ tipo_py(at.tipo) }} | None
{% endfor %}


class {{ a.clase }}:
    def __init__(self, id: str | None = None, **datos):
        self.id = id or str(uuid.uuid4())
{% for at in a.atributos %}
        self.{{ at.snake }}: {{ tipo_py(at.tipo) }} | None = None
{% endfor %}
        self._eventos: list[EventoDominio] = []
        self._aplicar({**VALORES_INICIALES, **datos})

    # ----------------------------------------------------------------- comandos (V6)
{% for c in a.comandos %}
{% if c.crea %}
    @classmethod
    def {{ c.metodo_snake }}(cls, datos: dict) -> "{{ a.clase }}":
        """Comando «{{ c.nombre }}»: crea el agregado."""
        agregado = cls(**{k: v for k, v in datos.items() if k != "id"})
{% for campo, minimo in c.minimos.items() %}
        if agregado.{{ campo | snake }} is None or agregado.{{ campo | snake }} < {{ minimo }}:
            raise ReglaNegocioError("«{{ c.nombre }}»: '{{ campo | snake }}' es obligatorio y debe ser mayor o igual a {{ minimo }}")
{% endfor %}
{% for f in c.fecha_futura %}
        if agregado.{{ f | snake }} is not None and agregado.{{ f | snake }} <= date.today():
            raise ReglaNegocioError("«{{ c.nombre }}»: '{{ f | snake }}' debe ser posterior a hoy")
{% endfor %}
{% if c.nuevo_estado %}
        agregado.estado = "{{ c.nuevo_estado }}"
{% endif %}
        agregado.validar()
{% if c.evento %}
        agregado._registrar({{ c.evento.clase }}(agregado.id, agregado.a_dict()))
{% endif %}
        return agregado

{% else %}
    def {{ c.metodo_snake }}(self, datos: dict) -> None:
        """Comando «{{ c.nombre }}»."""
{% if c.desde_estados %}
        if self.estado not in {{ c.desde_estados | tojson }}:
            raise ReglaNegocioError(f"«{{ c.nombre }}» no se permite con estado '{self.estado}'")
{% endif %}
{% for r in c.requiere %}
        if datos.get("{{ r | snake }}") in (None, ""):
            raise ReglaNegocioError("«{{ c.nombre }}» requiere '{{ r | snake }}'")
{% endfor %}
{% if c.restar %}
        if "{{ c.restar | snake }}" not in datos:
            raise ReglaNegocioError("«{{ c.nombre }}» requiere '{{ c.restar | snake }}'")
        try:
            resta = _convertir(CAMPOS["{{ c.restar | snake }}"], datos["{{ c.restar | snake }}"])
        except (TypeError, ValueError) as error:
            raise ReglaNegocioError(f"Valor inválido para '{{ c.restar | snake }}': {datos['{{ c.restar | snake }}']!r}") from error
        if resta is None or resta <= 0:
            raise ReglaNegocioError("«{{ c.nombre }}»: '{{ c.restar | snake }}' debe ser mayor que cero")
        self.{{ c.restar | snake }} = (self.{{ c.restar | snake }} or 0) - resta
{% else %}
        self._aplicar({k: v for k, v in datos.items() if k != "id"})
{% endif %}
{% for f in c.fecha_futura %}
        if self.{{ f | snake }} is not None and self.{{ f | snake }} <= date.today():
            raise ReglaNegocioError("«{{ c.nombre }}»: '{{ f | snake }}' debe ser posterior a hoy")
{% endfor %}
{% if c.nuevo_estado %}
        self.estado = "{{ c.nuevo_estado }}"
{% endif %}
        self.validar()
{% if c.evento %}
        self._registrar({{ c.evento.clase }}(self.id, self.a_dict()))
{% endif %}

{% endif %}
{% endfor %}
    # ----------------------------------------------------------------- invariantes
    def validar(self) -> None:
        for campo in OBLIGATORIOS:
            if getattr(self, campo) in (None, ""):
                raise ReglaNegocioError(f"El campo '{campo}' es obligatorio en {{ a.clase }}")
        for campo in NO_NEGATIVOS:
            valor = getattr(self, campo)
            if valor is not None and valor < 0:
                raise ReglaNegocioError(f"'{campo}' no puede ser negativo (valor: {valor})")
        for campo, permitidos in VALORES_PERMITIDOS.items():
            valor = getattr(self, campo)
            if valor is not None and valor not in permitidos:
                raise ReglaNegocioError(f"'{campo}' = '{valor}' no es válido. Permitidos: {permitidos}")
        for campo, regla in FORMATOS.items():
            valor = getattr(self, campo)
            if valor is None:
                continue
            if isinstance(valor, str):
                if regla["max_largo"] and len(valor) > regla["max_largo"]:
                    raise ReglaNegocioError(f"'{campo}' admite máximo {regla['max_largo']} caracteres")
                if regla["patron"] and not re.fullmatch(regla["patron"], valor):
                    raise ReglaNegocioError(f"'{campo}' {regla['mensaje']} (recibido: '{valor}')")
            else:
                if regla["minimo"] is not None and valor < regla["minimo"]:
                    raise ReglaNegocioError(f"'{campo}' debe ser mayor o igual a {regla['minimo']:g} (recibido: {valor})")
                if regla["maximo"] is not None and valor > regla["maximo"]:
                    raise ReglaNegocioError(f"'{campo}' debe ser menor o igual a {regla['maximo']:g} (recibido: {valor})")

    # ----------------------------------------------------------------- memento
    def crear_memento(self) -> {{ a.clase }}Memento:
        return {{ a.clase }}Memento(self.id{% for at in a.atributos %}, self.{{ at.snake }}{% endfor %})

    def restaurar(self, memento: {{ a.clase }}Memento) -> None:
{% for at in a.atributos %}
        self.{{ at.snake }} = memento.{{ at.snake }}
{% endfor %}
{% if not a.atributos %}
        pass
{% endif %}

    # ----------------------------------------------------------------- utilidades
    def _aplicar(self, datos: dict) -> None:
        for campo, valor in datos.items():
            if campo in CAMPOS:
                try:
                    setattr(self, campo, _convertir(CAMPOS[campo], valor))
                except (TypeError, ValueError) as error:
                    esperado = {"int": "un número entero", "float": "un número", "date": "una fecha AAAA-MM-DD",
                                "bool": "true o false", "str": "un texto"}[CAMPOS[campo].__name__]
                    raise ReglaNegocioError(f"Valor inválido para '{campo}': {valor!r} (se esperaba {esperado})") from error

    def _registrar(self, evento: EventoDominio) -> None:
        self._eventos.append(evento)

    def extraer_eventos(self) -> list[EventoDominio]:
        eventos, self._eventos = self._eventos, []
        return eventos

    def a_dict(self) -> dict:
        datos = {"id": self.id}
        for campo in CAMPOS:
            valor = getattr(self, campo)
            datos[campo] = valor.isoformat() if isinstance(valor, date) else valor
        return datos

    @classmethod
    def desde_dict(cls, datos: dict) -> "{{ a.clase }}":
        return cls(**datos)
