"""Comandos y sus manejadores (casos de uso de escritura) de {{ ctx.nombre }}.

Flujo de cada comando:
  1. se carga el agregado y se toma un memento (para deshacer o revertir)
  2. el agregado ejecuta el comando y valida sus invariantes
  3. si falla, se restaura el memento; si no, se guarda y se publican los eventos
"""
from __future__ import annotations

from dataclasses import dataclass, field

from {{ L.modelo }}.errores import NoEncontradoError, ReglaNegocioError
from {{ L.memento }}.memento import Caretaker
from {{ L.bus }}.bus_eventos import BusEventos
{% for a in ctx.agregados %}
from {{ L.modelo }}.{{ a.snake }} import {{ a.clase }}
from {{ L.puertos }}.repositorios import Repositorio{{ a.clase }}
{% endfor %}
{% for a in ctx.agregados %}
{% for c in a.comandos %}


@dataclass(frozen=True)
class {{ c.clase }}:
    """Comando «{{ c.nombre }}» (Application Process en V6)."""
    datos: dict = field(default_factory=dict)
{% if not c.crea %}
    id: str = ""
{% endif %}
{% endfor %}


class Manejador{{ a.clase }}:
    def __init__(self, repositorio: Repositorio{{ a.clase }}, bus: BusEventos, caretaker: Caretaker):
        self._repo = repositorio
        self._bus = bus
        self._caretaker = caretaker

    def _cargar(self, id: str) -> {{ a.clase }}:
        agregado = self._repo.obtener(id)
        if agregado is None:
            raise NoEncontradoError(f"{{ a.clase }} {id} no existe")
        return agregado

    def _confirmar(self, agregado: {{ a.clase }}) -> dict:
        self._repo.guardar(agregado)
        for evento in agregado.extraer_eventos():
            self._bus.publicar(evento)
        return agregado.a_dict()
{% for c in a.comandos %}

    def manejar_{{ c.metodo_snake }}(self, comando: {{ c.clase }}) -> dict:
{% if c.crea %}
        agregado = {{ a.clase }}.{{ c.metodo_snake }}(comando.datos)
        return self._confirmar(agregado)
{% else %}
        agregado = self._cargar(comando.id)
        memento = agregado.crear_memento()
        try:
            agregado.{{ c.metodo_snake }}(comando.datos)
        except ReglaNegocioError:
            agregado.restaurar(memento)
            raise
        self._caretaker.guardar(agregado.id, memento)
        return self._confirmar(agregado)
{% endif %}
{% endfor %}

    def deshacer(self, id: str) -> dict:
        """Restaura el estado anterior al último comando (patrón Memento)."""
        agregado = self._cargar(id)
        memento = self._caretaker.ultimo(id)
        if memento is None:
            raise ReglaNegocioError("No hay cambios para deshacer")
        agregado.restaurar(memento)
        self._repo.guardar(agregado)
        return agregado.a_dict()

    def obtener(self, id: str) -> dict:
        return self._cargar(id).a_dict()

    def listar(self) -> list[dict]:
        return [a.a_dict() for a in self._repo.listar()]
{% endfor %}
