using System.Globalization;

namespace {{ N.modelo }};

/// <summary>Conversión de valores a los tipos de los atributos del dominio (la usan los agregados).</summary>
public static class Conversion
{
    /// <summary>Texto sin espacios al inicio/final; "   " cuenta como vacío.</summary>
    public static string? Texto(string c, object? v)
    {
        var t = v?.ToString()?.Trim();
        return string.IsNullOrEmpty(t) ? null : t;
    }

    public static int? Entero(string c, object? v)
    {
        if (v is null) return null;
        if (v is string s0 && string.IsNullOrWhiteSpace(s0)) return null;
        if (v is bool) throw new ReglaNegocioException($"Valor inválido para '{c}': {v} (se esperaba un número entero)");
        if (v is double d && d % 1 != 0) throw new ReglaNegocioException($"Valor inválido para '{c}': {v} (se esperaba un número entero)");
        try { return v is string s1 ? int.Parse(s1.Trim(), CultureInfo.InvariantCulture) : Convert.ToInt32(v, CultureInfo.InvariantCulture); }
        catch (Exception) { throw new ReglaNegocioException($"Valor inválido para '{c}': {v} (se esperaba un número entero)"); }
    }

    public static double? Decimal(string c, object? v)
    {
        if (v is null) return null;
        if (v is string s0 && string.IsNullOrWhiteSpace(s0)) return null;
        if (v is bool) throw new ReglaNegocioException($"Valor inválido para '{c}': {v} (se esperaba un número)");
        try { return v is string s1 ? double.Parse(s1.Trim().Replace(',', '.'), CultureInfo.InvariantCulture) : Convert.ToDouble(v, CultureInfo.InvariantCulture); }
        catch (Exception) { throw new ReglaNegocioException($"Valor inválido para '{c}': {v} (se esperaba un número)"); }
    }

    public static DateOnly? Fecha(string c, object? v)
    {
        if (v is null) return null;
        if (v is DateOnly d) return d;
        if (v is DateTime dt) return DateOnly.FromDateTime(dt);   // así llegan las columnas DATE desde Npgsql
        return DateOnly.TryParseExact(v.ToString(), "yyyy-MM-dd", out var f) ? f : throw new ReglaNegocioException($"Valor inválido para '{c}': {v} (se esperaba una fecha AAAA-MM-DD)");
    }

    public static bool? Booleano(string c, object? v) => v is null ? null : Convert.ToBoolean(v, CultureInfo.InvariantCulture);
}
