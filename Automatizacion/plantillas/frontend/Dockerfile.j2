# {{ mf.nombre }} — se construye y despliega de forma independiente (un contenedor por microfrontend).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
# El frontend habla con el backend a través del gateway.
ARG VITE_API_URL=http://localhost:8080/api
ENV VITE_API_URL=$VITE_API_URL
{% if mf.carpeta == "shell" %}
{% for r in fe.remotos %}
ARG {{ r.federado | upper }}_URL=http://localhost:{{ r.puerto }}/
ENV {{ r.federado | upper }}_URL=${{ r.federado | upper }}_URL
{% endfor %}
{% else %}
ARG MF_URL=http://localhost:{{ mf.puerto }}/
ENV MF_URL=$MF_URL
{% endif %}
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
